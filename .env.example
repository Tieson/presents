# Heslo do administrace (dílny)
ADMIN_PASSWORD=zmen-me

# Tajný klíč pro podpisy (dlouhý náhodný řetězec). Když chybí, odvodí se z ADMIN_PASSWORD.
APP_SECRET=

# --- Lokálně / vlastní server: data na disk ---
STORAGE=fs
DATA_DIR=./data
PORT=3000
MAX_UPLOAD_MB=15

# --- Vercel: tyhle proměnné doplní Vercel sám po připojení Upstash Redis a Blob ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
