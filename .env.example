# Tajný klíč aplikace (povinný, aspoň 16 znaků): podepisuje přihlášení do dílen a šifruje jejich odkazy.
# Vygeneruj třeba: openssl rand -base64 32
# Pozor: když ho později změníš, všechny dílny se odhlásí a uložené odkazy přestane jít v dílně zobrazit
# (samotné odkazy dál fungují).
APP_SECRET=

# Kdo smí zakládat dílny. Prázdné = kdokoli. Vyplněné = při založení je potřeba zadat tenhle kód.
SIGNUP_CODE=

# Limity na jednu dílnu
MAX_GIFTS=50
MAX_STORAGE_MB=100

# --- Lokálně / vlastní server: data na disk ---
STORAGE=fs
DATA_DIR=./data
PORT=3000
MAX_UPLOAD_MB=15

# --- Vercel: tyhle proměnné doplní Vercel sám po připojení Upstash Redis a Blob ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
#
# Když má integrace prefix (např. „present“ → present_KV_REST_API_URL), aplikace ho najde sama.
# Nastavit ho je potřeba jen tehdy, když je v projektu připojených víc databází:
# STORAGE_ENV_PREFIX=present
#
# Začátek všech klíčů v Redisu (hodí se při sdílené databázi). Výchozí „xd:“.
# Pozor: po změně aplikace neuvidí data uložená pod starým prefixem.
# REDIS_KEY_PREFIX=xd:
